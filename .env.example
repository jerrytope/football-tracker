# ════════════════════════════════════════════════════════════
#  Football Tracker — Environment Variables Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════

# ── Django ───────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-this-with-a-long-random-string
DEBUG=True

# Allowed hosts (comma-separated, no spaces)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://ft_user:ft_password@localhost:5432/football_tracker

# Individual values used by docker-compose.yml
POSTGRES_DB=football_tracker
POSTGRES_USER=ft_user
POSTGRES_PASSWORD=ft_password

# ── Redis / Celery ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── AWS S3 (set USE_S3=False for local dev) ──────────────────
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=us-east-1

# ── YOLO Weights ─────────────────────────────────────────────
# S3 path to the .pt weights file (used by Celery workers in production)
YOLO_WEIGHTS_S3_PATH=s3://your-s3-bucket-name/weights/yolov8x.pt
# Local path where weights are cached after download
YOLO_WEIGHTS_LOCAL_PATH=./cv_engine/weights/yolov8x.pt

# ── Sentry (optional — leave blank to disable) ───────────────
SENTRY_DSN=

# ── Frontend ─────────────────────────────────────────────────
# URL of the Django backend (used by the frontend in development)
VITE_API_BASE_URL=http://localhost:8000
